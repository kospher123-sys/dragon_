{
  "name": "blackflame-desktop",
  "productName": "흑염룡",
  "version": "1.6.0",
  "description": "흑염룡 연대기 데스크톱",
  "main": "dist/main/main.js",
  "private": true,
  "scripts": {
    "build:main": "esbuild src/main/main.ts src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist/main --sourcemap=inline",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer && node tools/webp.mjs",
    "test": "vitest run",
    "start": "npm run build && electron ."
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.10.0",
    "esbuild": "^0.25.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resedit": "^3.1.0",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  }
}
